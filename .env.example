# Contact form delivery — sent via Gmail SMTP through /api/contact.
# 1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Generate an App Password: myaccount.google.com/apppasswords
# 3. Paste it below (NOT your regular Gmail password).
GMAIL_USER=REPLACE_ME@gmail.com
GMAIL_APP_PASSWORD=REPLACE_ME

# Editable business placeholders
# NOTE: the live site renders these placeholders verbatim, so the App Store /
# Google Play buttons on nexusjo.fit currently lead nowhere. The values are
# read from the HOSTING environment (Vercel etc.) at build time — editing this
# file alone changes nothing. Update them where the site is deployed.
#
# The real App Store id is 6795261287 (see codemagic.yaml / App Store Connect).
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6795261287
# NEXUS is not on Google Play yet — leaving this empty lets the code's
# `?? "#"` fallback keep the button inert instead of linking to a 404.
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=+966500000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@nexus-app.com
